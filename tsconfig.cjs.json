{
  // CommonJS build: compiles only the library sources to dist/cjs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "node16",
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/cjs",
    "rootDir": "./src"
  },
  "include": ["src"]
}
